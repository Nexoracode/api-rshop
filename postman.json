  "info": {
    "title": "RShop Api",
    "description": "the RShop API description",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "RShop",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "RequestDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "email or phone"
          }
        },
        "required": [
          "identifier"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "email or phone"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "code"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "isPhoneVerified": {
            "type": "boolean"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "super_admin",
              "admin",
              "user"
            ]
          },
          "isActive": {
            "type": "boolean"
          },
          "avatarUrl": {
            "type": "string"
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "firstName",
          "lastName",
          "phone",
          "isPhoneVerified",
          "email",
          "password",
